# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
APP_URL=http://localhost:3000
ARC_RPC_URL=https://rpc.testnet.arc.io
ARKIV_RPC_URL=
ARKIV_ACCESS_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Archived World settings are optional and inactive; World API routes return HTTP 410.
WORLD_APP_ID=
WORLD_ACTION=
SWARM_BEE_URL=
SWARM_GATEWAY_URL=
SWARM_POSTAGE_BATCH_ID=
SWARM_BEE_API_KEY=
SESSION_SECRET=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# staging uses World simulator identities; never grant production permissions from staging proofs.
WORLD_ENVIRONMENT=staging
# WORLD_ACTION is a stable prefix. Register/allow the derived action prefix:chainId:lowercaseCampaign in the World portal.
# WORLD_RP_SIGNING_KEY authenticates IDKit requests only; it is never a contribution authorization key.
# Separate EIP-712 funding signer, configured once on the matching factory. Never reuse the RP key.
WORLD_VERIFIER_PRIVATE_KEY=
# Funding accepts production proofs by default. For Arc Testnet simulator checks only, set BOTH World environments to staging.
WORLD_AUTHORIZATION_ENVIRONMENT=production

# CRE simulation runner: HTTPS in hosting; loopback HTTP is allowed for local development.
CRE_RUNNER_URL=http://127.0.0.1:2020/verify
CRE_RUNNER_SECRET=
