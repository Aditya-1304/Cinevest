# Copy to .env. Never commit secrets. Use the SAME runner secret in apps/backend/.env.local.
CRE_RUNNER_SECRET=
CRE_RUNNER_HOST=127.0.0.1
CRE_RUNNER_PORT=2020
# Optional absolute CLI path; defaults to cre on PATH.
CRE_BIN=cre
# Separate Mux token with Video READ permissions only. No playback signing key is needed here.
MUX_CRE_TOKEN_ID=
MUX_CRE_TOKEN_SECRET=
