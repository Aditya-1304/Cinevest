{
  "name": "cinevest",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,backend \"npm run dev -w @cinevest/web\" \"npm run dev -w @cinevest/backend\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:abi": "npm run contracts:build && node scripts/generate-abi.mjs",
    "contracts:deploy:arc": "NODE_USE_ENV_PROXY=1 node scripts/deploy-arc.mjs"
  },
  "devDependencies": {
    "@foundry-rs/forge": "1.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
